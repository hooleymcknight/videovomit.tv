{
  "name": "videovomit.tv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pm2start": "pm2 start npm --name $npm_package_name -- start",
    "deploy": "npm run pm2delete pm2 start npm --name $npm_package_name -- start",
    "fulldeploy": "git fetch && git pull origin main && npm run pm2delete npm run build && pm2 start npm --name $npm_package_name -- start",
    "order": "echo 'fetch, pull, pm2 delete, run build, pm2 start'",
    "pm2delete": "pm2 delete $npm_package_name || true"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.0",
    "embla-carousel-react": "^8.6.0",
    "next": "16.1.0",
    "next-auth": "^4.24.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.61.1",
    "react-lite-youtube-embed": "^3.6.0",
    "react-use-hoverintent": "^1.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "prisma": "^6.5.0",
    "tailwindcss": "^4"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  }
}
